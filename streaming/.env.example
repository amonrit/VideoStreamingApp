# MediaMTX Streaming Server Configuration
# Copy this file to .env.local and customize for your environment

# ============================================================================
# Server Settings
# ============================================================================

# Log level: info, debug, warn, error
MEDIAMTX_LOGLEVEL=info

# Server IP binding (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
# Leave as 0.0.0.0 for network access, change to 127.0.0.1 for local-only
SERVER_IP=0.0.0.0

# ============================================================================
# Publishing (RTMP) Credentials
# ============================================================================

# Username and password for RTMP publishing (protect against unauthorized streams)
PUBLISH_USER=publish
PUBLISH_PASS=streampass123

# ============================================================================
# Recording Configuration
# ============================================================================

# Enable recording of all published streams (true/false)
ENABLE_RECORDING=false

# Recording format: fmp4 (fragmented) or mp4 (standard)
# fmp4 is recommended for streaming servers (faster writes)
RECORD_FORMAT=fmp4

# Recording output directory (relative to docker-compose.yml)
RECORD_PATH=./recordings

# ============================================================================
# Port Configuration
# ============================================================================

# RTMP Publishing Port (default 1935)
RTMP_PORT=1935

# RTSP Playback Port (default 8554)
RTSP_PORT=8554

# HLS Playback Port (default 8888)
HLS_PORT=8888

# WebRTC Low-Latency Port (default 8889)
WEBRTC_PORT=8889

# SRT Backup Port (default 8890)
SRT_PORT=8890

# ============================================================================
# HLS Configuration
# ============================================================================

# HLS segment duration in seconds (lower = lower latency but more CPU)
HLS_SEGMENT_DURATION=2s

# Number of segments in the playlist (more = more buffering)
HLS_SEGMENT_COUNT=3

# HLS variant: standard or lowLatency
HLS_VARIANT=standard

# ============================================================================
# Network & Timeout
# ============================================================================

# Read timeout for connections (seconds)
READ_TIMEOUT=10s

# Write timeout for connections (seconds)
WRITE_TIMEOUT=10s

# ============================================================================
# Advanced (Optional)
# ============================================================================

# Enable metrics endpoint (for monitoring/Prometheus)
# METRICS_ENABLED=true
# METRICS_PORT=9997

# Enable CORS for HLS playback from web (cross-origin requests)
# CORS_ENABLED=true

# Custom domain/hostname for absolute URLs in playlists
# PUBLISH_DOMAIN=example.com
