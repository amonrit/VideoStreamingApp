{
  "description": "Steam iOS Streaming App - Claude Code Configuration",
  "version": "1.0",

  "environment": {
    "workingDirectory": "/Users/amonrit/Documents/steam",
    "projectType": "swift-ios",
    "primaryLanguage": "swift"
  },

  "models": {
    "default": "claude-opus",
    "fastMode": "claude-opus",
    "codeReview": "claude-opus",
    "architecture": "claude-opus"
  },

  "capabilities": {
    "enabledSkills": [
      "code-review",
      "tdd",
      "codebase-design",
      "request-refactor-plan",
      "security-review",
      "diagnosing-bugs"
    ],
    "enableArtifacts": true,
    "enableWorkflows": true,
    "allowMultiAgent": true
  },

  "preferences": {
    "responseStyle": "concise",
    "includeCodeExamples": true,
    "explainArchitecture": true,
    "suggestTestCases": true
  },

  "gitignore": [
    "DerivedData/",
    "build/",
    ".build/",
    "*.xcuserstate",
    "*.xcuserdata",
    ".DS_Store",
    "recordings/"
  ],

  "keyFiles": {
    "readme": "README.md",
    "architecture": "ARCHITECTURE.md",
    "claude": "CLAUDE.md",
    "deployment": "DEPLOYMENT_GUIDE.md",
    "roadmap": "FEATURES_ROADMAP.md",
    "makefile": "Makefile"
  },

  "codeStyle": {
    "language": "swift",
    "indentation": 4,
    "lineLength": 120,
    "commentStyle": "inline"
  },

  "testing": {
    "frameworkPreference": "XCTest",
    "testPath": "steam/Tests",
    "generateTestStubs": true
  },

  "antigravity": {
    "enabled": true,
    "codeUnderstandingMode": "semantic",
    "semanticIndexing": true,
    "indexedPaths": [
      "steam/App/",
      "steam/Core/",
      "steam/Features/",
      "steam/DesignSystem/",
      "streaming/"
    ],
    "skipPaths": [
      "DerivedData/",
      "build/",
      ".build/",
      "recordings/",
      "*.xcuserdata"
    ],
    "semanticAnalysis": {
      "enabled": true,
      "followImports": true,
      "resolveTypes": true,
      "trackDataFlow": true
    },
    "codeRelationships": {
      "findUsages": true,
      "findImplementations": true,
      "trackDependencies": true,
      "showCallGraphs": true
    }
  },

  "mcp": {
    "enabledServers": [
      "filesystem",
      "git",
      "github"
    ],
    "github": {
      "repository": "amonrit/VideoStreamingApp",
      "enabled": true,
      "features": [
        "issues",
        "pull_requests",
        "repository_info"
      ]
    }
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "agent",
            "prompt": "User is about to run: $ARGUMENTS\n\nIf this is a git commit command, MUST read docs/COMMIT_GUIDE.md (lines 1-100) and confirm adherence to:\n1. ❌ No Co-Authored-By footer (absolutely forbidden)\n2. ✅ Format: <type>(<scope>): <subject>\n3. ✅ Subject ≤50 chars, imperative mood (add not added)\n4. ✅ No period at end of subject\n5. ✅ Body explains why (optional but recommended)\n6. ✅ Footer: issue references only (Closes #42, Fixes #42)\n\nIf it's a git commit, report back the commit message standards you reviewed. If not a commit command, just acknowledge and proceed.",
            "if": "Bash(git commit*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "make build-app 2>&1 | tail -20",
            "if": "Bash(git push*)",
            "timeout": 120,
            "statusMessage": "Verifying build before push..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path // .tool_response.filePath' 2>/dev/null); if [[ \"$FILE\" == *.swift ]]; then echo \"Running tests after Swift file change...\"; make test-app 2>&1 | tail -20; fi",
            "timeout": 120,
            "statusMessage": "Running tests for Swift changes..."
          },
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path // .tool_response.filePath' 2>/dev/null); if [[ \"$FILE\" == *.md ]]; then TIMESTAMP=$(date +%s); DATE=$(date +%m/%d/%Y); USERNAME=$(git config user.name 2>/dev/null || echo 'amonrit'); sed -i '' \"1s/^.*$/Last Modified: $DATE ($TIMESTAMP) by $USERNAME/\" \"$FILE\" 2>/dev/null || true; echo \"Updated markdown header: $FILE\"; fi",
            "timeout": 10,
            "statusMessage": "Updating markdown headers..."
          }
        ]
      }
    ]
  }
}
