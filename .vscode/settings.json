{
  "description": "VS Code settings optimized for Claude Code + Antigravity + Swift development",

  "editor.defaultFormatter": "apple.swift-format",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.indentSize": 4,
  "editor.wordWrap": "on",
  "editor.rulers": [120],

  "[swift]": {
    "editor.defaultFormatter": "apple.swift-format",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },

  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },

  "[json]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true
  },

  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
    "editor.trimAutoWhitespace": false
  },

  "files.exclude": {
    "**/.DS_Store": true,
    "**/DerivedData": true,
    "**/*.xcuserstate": true,
    "**/*.xcuserdata": true,
    "**/.build": true,
    "**/build": true
  },

  "files.watcherExclude": {
    "**/DerivedData/**": true,
    "**/build/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },

  "search.exclude": {
    "**/DerivedData": true,
    "**/build": true,
    "**/.build": true,
    "**/recordings": true
  },

  "extensions.recommendations": [
    "GitHub.copilot",
    "ms-python.python",
    "ms-vscode.makefile-tools"
  ],

  "git.ignoreLimitWarning": true,

  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "Menlo, Monaco, 'Courier New'",
  "terminal.integrated.fontSize": 12,

  "claude": {
    "enabled": true,
    "configPath": ".claude/settings.json",
    "features": {
      "codeCompletion": true,
      "codeReview": true,
      "documentation": true,
      "testing": true,
      "debugging": true,
      "refactoring": true
    }
  },

  "antigravity": {
    "enabled": true,
    "codeUnderstanding": true,
    "semanticAnalysis": true,
    "showCodeRelationships": true,
    "indexing": {
      "enabled": true,
      "incremental": true
    }
  },

  "copilot": {
    "enable": {
      "*": true,
      "plaintext": false,
      "markdown": false,
      "scminput": false
    }
  },

  "swift": {
    "lint": {
      "enabled": true,
      "path": "swift"
    },
    "format": {
      "enabled": true,
      "indentation": 4
    }
  },

  "problems.decorations.enabled": true,

  "editor.codeActionsOnSave": {
    "source.fixAll": true,
    "source.organizeImports": true
  },

  "editor.semanticHighlighting.enabled": true,

  "workbench.colorTheme": "Default Dark Modern",
  "workbench.editor.enablePreview": true,
  "workbench.editorAssociations": {
    "*.pdf": "default"
  },

  "debug.onTaskErrors": "prompt",

  "security.workspace.trust.untrustedFiles": "open"
}
